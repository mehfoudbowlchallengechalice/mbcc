# Non-secret spreadsheet identifiers supplied by the owner.
MBCC_CHALLENGE_SHEET_ID=1jKYvXmWIB39FPGsEIGatP_KTY_VK53TnDxNSBVokfVs
# These summary tabs are in the challenge workbook, like the Streamlit app.
MBCC_HISTORY_SHEET_ID=1jKYvXmWIB39FPGsEIGatP_KTY_VK53TnDxNSBVokfVs
# Optional second challenge workbook, using the same tabs and column layout.
# Share it with the same reader service account before selecting sub.
MBCC_SUB_CHALLENGE_SHEET_ID=
# Subgroup history defaults to the subgroup challenge workbook.
MBCC_SUB_HISTORY_SHEET_ID=
# Optional subgroup playoff totals; blank leaves them unavailable.
MBCC_SUB_PLAYOFF_HISTORY_SHEET_ID=
# The subgroup does not need a todays_update tab unless explicitly enabled.
MBCC_SUB_UPDATES_ENABLED=0
MBCC_PLAYOFF_HISTORY_SHEET_ID=1Iwl1WEzLEXu05ZtFcfZovWwQsECNy8LH3II760C-w2E
MBCC_PLAYOFF_HISTORY_ENABLED=1
MBCC_SEASON='MBCC 15 · 2026–27'
# The manually uploaded live_scores_and_games tab is the primary game source.
MBCC_LIVE_SCORES_ENABLED=1
# Create the todays_update worksheet before enabling this.
MBCC_UPDATES_ENABLED=0

# Set this to a local credential file; never commit the file or paste its contents.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
PORT=8000
