# Optional overrides. Google credentials and worksheet settings belong on the backend.
# Legacy [connections.gsheets] settings are ignored and can be removed.
[mbcc]
data_source = "api" # "api" or "demo"; legacy "sheets" now uses the API.
endpoint = "https://mbcc-api-jarvycxodq-ue.a.run.app/api/snapshot"
group_keyword = "default" # blank/default, sub, or default+sub; editable in the sidebar.
